[Unit]
Description=Fenghuo server
Documentation=https://github.com/mby/fenghuo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fenghuo
Group=fenghuo
StateDirectory=fenghuo
StateDirectoryMode=0700
Environment=FENGHUO_DATA=/var/lib/fenghuo
Environment=GOMEMLIMIT=200MiB
EnvironmentFile=-/etc/fenghuo/server.env
ExecStart=/usr/local/bin/fenghuo-server serve
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
