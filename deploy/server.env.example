# /etc/fenghuo/server.env — every flag of `fenghuo-server serve` can be set here
# as FENGHUO_<FLAG_NAME>. See docs/configuration.md for the full list.

# Public listener: agent reports and the read-only status page.
# Keep it on loopback and put a TLS reverse proxy (Caddy, nginx) in front.
FENGHUO_LISTEN=127.0.0.1:8080

# Admin listener. Loopback only by default: reach it through an SSH tunnel,
#   ssh -L 8081:127.0.0.1:8081 you@this-server
# then open http://127.0.0.1:8081.
# "shared" serves admin on FENGHUO_LISTEN (enable two-factor auth if you do),
# "off" disables the admin UI completely.
FENGHUO_ADMIN_LISTEN=127.0.0.1:8081

# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted.
FENGHUO_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Retention. Raw per-report samples are never stored.
FENGHUO_KEEP_MINUTE_DAYS=7
FENGHUO_KEEP_HOUR_DAYS=90

# Allow notifications to private or loopback addresses (self-hosted webhooks,
# local HTTP proxies). Off by default to prevent SSRF.
#FENGHUO_NOTIFY_ALLOW_PRIVATE=true

# Use an HTTP proxy for outgoing notifications (e.g. to reach Telegram).
#HTTPS_PROXY=http://proxy.example.com:3128

# Billing periods reset at local midnight in this time zone.
#TZ=Asia/Shanghai

#FENGHUO_LOG_LEVEL=info
