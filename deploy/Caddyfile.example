# Public status page and agent endpoint. Caddy obtains the certificate automatically.
probe.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# Optional: expose the admin UI on its own domain, restricted to your IPs.
# The SSH tunnel described in the README is safer and needs no extra config.
#
# admin.probe.example.com {
# 	@outsiders not remote_ip 203.0.113.10 198.51.100.0/24
# 	respond @outsiders 403
# 	reverse_proxy 127.0.0.1:8081
# }
